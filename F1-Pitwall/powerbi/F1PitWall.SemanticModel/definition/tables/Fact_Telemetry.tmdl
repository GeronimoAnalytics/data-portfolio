/// Distance-resampled car telemetry + derived physics (G-forces, est. brake pressure)
table Fact_Telemetry
	lineageTag: de6df108-e7fe-47c5-ab94-aa2a193ba8f5

	column RaceID
		dataType: int64
		isHidden
		lineageTag: 52f3cb52-c60a-4afe-ac57-c3a518065d56
		summarizeBy: none
		sourceColumn: RaceID

	column DriverID
		dataType: string
